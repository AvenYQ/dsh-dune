{
  "name": "dsh-dune",
  "version": "0.1.0",
  "description": "Tactile skin for DeepSeek Harness — warm paper surfaces, tight typography, spring sidebar motion, per-workspace icon picker and AI-designed themes",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "fonts/outfit.b64.js",
    "cordis.patch.yml",
    "README.md",
    "fonts/OFL.txt",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "dune",
    "typography"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT"
}
