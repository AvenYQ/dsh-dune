{
  "name": "dsh-aven-dune",
  "version": "0.8.0",
  "description": "Dune skin for DeepSeek Harness — warm paper surfaces, animated backdrops (Claude Code theme-examples), switchable text reveal, comet caret, material and typography toggles, per-workspace icons and AI-designed themes，侧栏入口拖动排序与收进「更多」",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "fonts/outfit.b64.js",
    "cordis.patch.yml",
    "README.md",
    "fonts/OFL.txt",
    "LICENSE",
    "licenses/theme-examples-LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "dune",
    "typography",
    "reveal",
    "cursor",
    "caret",
    "effects",
    "backdrop",
    "animated-background"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvenYQ/dsh-dune.git"
  }
}
